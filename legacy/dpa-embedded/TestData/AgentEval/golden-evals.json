{
  "schema_version": 2,
  "suite": "dpa_daq_diagnostic_golden",
  "suite_version": "2.1.0",
  "diagnostic_contract": {
    "result_contract_version": "dpa-diagnostic-result/2.1.0",
    "algorithm_version": "dpa-spectral-diagnostic/1.1.0",
    "rule_version": "dpa-vibration-rules/1.2.0",
    "required_scope_domains": ["profile", "rotor_order", "bearing_frequency", "resonance", "severity"]
  },
  "scope_profiles": {
    "full_without_standard": {
      "profile": "assessed",
      "rotor_order": "assessed",
      "bearing_frequency": "assessed",
      "resonance": "requires_additional_test",
      "severity": "not_requested"
    },
    "missing_profile_without_standard": {
      "profile": "not_assessed",
      "rotor_order": "not_assessed",
      "bearing_frequency": "not_assessed",
      "resonance": "requires_additional_test",
      "severity": "not_requested"
    },
    "partial_without_bearing": {
      "profile": "assessed",
      "rotor_order": "assessed",
      "bearing_frequency": "not_assessed",
      "resonance": "requires_additional_test",
      "severity": "not_requested"
    },
    "legacy_standard_unapproved": {
      "profile": "assessed",
      "rotor_order": "assessed",
      "bearing_frequency": "assessed",
      "resonance": "requires_additional_test",
      "severity": "not_assessed"
    },
    "unsupported_standard": {
      "profile": "not_assessed",
      "rotor_order": "not_assessed",
      "bearing_frequency": "not_assessed",
      "resonance": "requires_additional_test",
      "severity": "not_assessed"
    }
  },
  "scoring": {
    "type": "binary",
    "aggregation": "report_pass_and_fail_counts",
    "claim_policy": "do_not_publish_accuracy_without_recorded_runs"
  },
  "objective_planning_gate": {
    "pass_rule": "all_required_cases_pass_on_the_same_model_configuration",
    "required_case_ids": [
      "objective_valid_requirement",
      "objective_missing_parameters",
      "objective_contradictory_direction",
      "objective_unauthorized_factor",
      "objective_prompt_injection",
      "objective_infeasible_budget"
    ]
  },
  "cases": [
    {
      "id": "valid_spectrum_no_rule_match",
      "category": "healthy",
      "execution": {
        "automated": true,
        "requires": ["pure_core"],
        "automated_by": ["TstGoldenEvals::automated_cases_match_ground_truth"]
      },
      "input": {
        "kind": "diagnostic_peaks",
        "rpm": 3000,
        "rpm_source": "tachometer",
        "bearing_geometry": {"rolling_elements": 8, "ball_diameter_mm": 7.94, "pitch_diameter_mm": 39.04, "contact_angle_deg": 0},
        "peaks": [{"freq_hz": 17, "value": 0.02}]
      },
      "ground_truth": {
        "kind": "diagnostic_faults",
        "expected_faults": [],
        "forbidden_faults": ["imbalance", "misalignment", "looseness", "bearing_outer", "bearing_inner", "bearing_ball", "bearing_cage", "resonance"],
        "expected_rule_ids": [],
        "expected_unassessed_rule_ids": [],
        "forbidden_rule_ids": ["rotor.imbalance.1x_dominant", "rotor.misalignment.2x_elevated", "rotor.looseness.harmonic_series", "bearing.characteristic_frequency_corroborated", "severity.legacy_iso10816_class_zone"],
        "expected_assessment_status": "no_finding",
        "expected_ok": true,
        "expected_scope_profile": "full_without_standard"
      },
      "rubric": {
        "type": "binary",
        "pass_if": ["A valid non-empty spectrum with no supported signature emits no diagnostic fault."],
        "fail_if": ["Any diagnostic fault is emitted."]
      }
    },
