{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dpa.local/schemas/experiment-objective.schema.json",
  "title": "DPA governed experiment objective",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "objective_id",
    "context_fingerprint",
    "tool_catalog_sha256",
    "hypothesis",
    "response",
    "constraints",
    "allowed_factors",
    "budget",
    "stop_conditions",
    "evidence_requirements"
  ],
  "properties": {
    "schema": { "const": "dpa.experiment.objective" },
    "version": { "const": 1 },
    "objective_id": { "$ref": "#/$defs/token96" },
    "context_fingerprint": { "$ref": "#/$defs/sha256" },
    "tool_catalog_sha256": { "$ref": "#/$defs/sha256" },
    "hypothesis": { "type": "string", "minLength": 8, "maxLength": 512 },
    "response": { "$ref": "#/$defs/response" },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fixed_plan", "randomize", "min_replicates"],
      "properties": {
        "fixed_plan": { "$ref": "#/$defs/fixedPlan" },
        "randomize": { "type": "boolean" },
        "min_replicates": { "type": "integer", "minimum": 1, "maximum": 5 }
      }
    },
    "allowed_factors": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": { "$ref": "#/$defs/factor" }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_runs", "max_run_duration_ms", "max_total_duration_ms"],
      "properties": {
        "max_runs": { "type": "integer", "minimum": 2, "maximum": 64 },
        "max_run_duration_ms": { "type": "integer", "minimum": 1000, "maximum": 600000 },
        "max_total_duration_ms": { "type": "integer", "minimum": 1000, "maximum": 38400000 }
      }
    },
    "stop_conditions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stop_on_warning", "on_run_failure", "max_failed_runs", "interim_after"],
      "properties": {
        "stop_on_warning": { "const": true },
        "on_run_failure": { "enum": ["abort", "continue"] },
        "max_failed_runs": { "type": "integer", "minimum": 0, "maximum": 64 },
        "interim_after": { "type": "integer", "minimum": 0, "maximum": 63 }
      },
      "allOf": [
        {
          "if": { "properties": { "on_run_failure": { "const": "abort" } } },
          "then": { "properties": { "max_failed_runs": { "const": 0 } } },
          "else": { "properties": { "max_failed_runs": { "minimum": 1 } } }
        }
      ]
    },
    "evidence_requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "save_raw_data",
        "create_per_run_evidence",
        "verify_current_catalog",
        "auto_analyze",
        "auto_refine"
      ],
      "properties": {
        "save_raw_data": { "const": true },
        "create_per_run_evidence": { "const": true },
        "verify_current_catalog": { "const": true },
        "auto_analyze": { "const": true },
        "auto_refine": { "const": true }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "token96": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,96}$" },
    "unit": { "type": "string", "pattern": "^\\S{1,32}$" },
    "response": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["metric", "unit", "direction"],
          "properties": {
            "metric": { "enum": ["rms", "peak", "peak_freq", "crest_factor"] },
            "unit": { "$ref": "#/$defs/unit" },
            "direction": { "enum": ["maximize", "minimize"] }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["metric", "unit", "direction", "target", "tolerance"],
          "properties": {
            "metric": { "enum": ["rms", "peak", "peak_freq", "crest_factor"] },
            "unit": { "$ref": "#/$defs/unit" },
            "direction": { "const": "target" },
            "target": { "type": "number", "minimum": -1000000000000, "maximum": 1000000000000 },
            "tolerance": { "type": "number", "exclusiveMinimum": 0, "maximum": 1000000000000 }
          }
        }
      ],
      "allOf": [
        {
          "if": { "properties": { "metric": { "const": "peak_freq" } } },
          "then": { "properties": { "unit": { "const": "Hz" } } }
        },
        {
          "if": { "properties": { "metric": { "const": "crest_factor" } } },
          "then": { "properties": { "unit": { "const": "1" } } }
        }
      ]
    },
    "fixedPlan": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "duration_ms": { "type": "integer", "minimum": 1000, "maximum": 600000 },
        "analysis_type": { "enum": ["FFT", "PSD", "DFT", "RMSPRO", "AVGPRO", "PEAKPRO"] },
        "frame_size": { "enum": [128, 256, 512, 1024, 2048, 4096, 8192, 16384, 32768] },
        "average_num": { "type": "integer", "minimum": 1, "maximum": 99 },
        "overlap_index": { "type": "integer", "minimum": 0, "maximum": 5 },
        "auto_connect": { "type": "boolean" },
        "standard_plan_required": { "type": "boolean" },
        "generate_report": { "type": "boolean" }
      }
    },
    "factor": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "levels"],
          "properties": {
            "name": { "const": "duration_ms" },
            "levels": { "type": "array", "minItems": 2, "maxItems": 8, "uniqueItems": true, "items": { "type": "integer", "minimum": 1000, "maximum": 600000 } }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "levels"],
          "properties": {
            "name": { "const": "analysis_type" },
            "levels": { "type": "array", "minItems": 2, "maxItems": 8, "uniqueItems": true, "items": { "enum": ["FFT", "PSD", "DFT", "RMSPRO", "AVGPRO", "PEAKPRO"] } }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "levels"],
          "properties": {
            "name": { "const": "frame_size" },
            "levels": { "type": "array", "minItems": 2, "maxItems": 8, "uniqueItems": true, "items": { "enum": [128, 256, 512, 1024, 2048, 4096, 8192, 16384, 32768] } }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "levels"],
          "properties": {
            "name": { "const": "average_num" },
            "levels": { "type": "array", "minItems": 2, "maxItems": 8, "uniqueItems": true, "items": { "type": "integer", "minimum": 1, "maximum": 99 } }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "levels"],
          "properties": {
            "name": { "const": "overlap_index" },
            "levels": { "type": "array", "minItems": 2, "maxItems": 6, "uniqueItems": true, "items": { "type": "integer", "minimum": 0, "maximum": 5 } }
          }
        }
      ]
    }
  }
}
